    {
      "parameters": {
        "jsCode": "const results = {};\nconst originalPlayerId = $('Get a row').first().json.id;\nconst allStatKeys = new Set(); // To track every unique stat found\n\nconst items = $input.all();\n\n// 1. First pass: Group stats and find all unique column names\nfor (const item of items) {\n  const season = item.json.season;\n  const category = String(item.json.category || 'unknown').toLowerCase();\n  const statType = String(item.json.statType || 'unknown').toLowerCase();\n  const statValue = parseFloat(item.json.stat) || 0;\n  const rawColName = `${category}_${statType}`;\n\n  allStatKeys.add(rawColName);\n\n  if (!results[season]) {\n    results[season] = {\n      player_id: originalPlayerId,\n      season: season,\n      team: item.json.team,\n      player_name: item.json.player\n    };\n  }\n\n  if (results[season].hasOwnProperty(rawColName)) {\n    results[season][rawColName] += statValue;\n  } else {\n    results[season][rawColName] = statValue;\n  }\n}\n\n// 2. Second pass: Normalize! \n// Ensure every season has every key found, otherwise set to 0\nconst finalRows = Object.values(results);\nfor (const row of finalRows) {\n  allStatKeys.forEach(key => {\n    if (!row.hasOwnProperty(key)) {\n      row[key] = 0;\n    }\n  });\n}\n\nreturn finalRows.map(r => ({ json: r }));"
      },
