    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  try {\n    const raw = item.json.output; \n    const parsed = JSON.parse(raw.replace(/```json|```/g, \"\").trim());\n    Object.assign(item.json, parsed); \n  } catch (e) {\n    item.json.error = \"AI output wasn't clean JSON\";\n  }\n}\nreturn $input.all();"
      },
