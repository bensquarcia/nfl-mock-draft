    {
      "parameters": {
        "jsCode": "// This node creates a list of every potential year for every team found.\nconst allItems = $input.all();\nconst currentYear = 2025; \nconst yearsToLookBack = 4; // This will check 2025, 2024, 2023, and 2022\nlet searchTasks = [];\n\nfor (const item of allItems) {\n  const team = item.json.team;\n  const playerName = item.json.name;\n  const playerId = item.json.id;\n\n  for (let i = 0; i < yearsToLookBack; i++) {\n    searchTasks.push({\n      json: {\n        player_name: playerName,\n        team: team,\n        season: currentYear - i,\n        original_id: playerId // Keeping your Supabase ID safe\n      }\n    });\n  }\n}\n\nreturn searchTasks;"
      },
